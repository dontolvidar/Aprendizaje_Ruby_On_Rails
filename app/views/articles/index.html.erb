<h1>Articles List</h1>
<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
    </tr>
  </thead>

  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= link_to article.tittle, article_path(article) %></td>
        <td><%= article.descripction %></td>
      </tr>
    <% end %>
  </tbody>